<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
	bootstrap="tests/native/bootstrap.php" cacheDirectory=".cache/phpunit-native"
	failOnEmptyTestSuite="true" failOnWarning="true" failOnRisky="true"
	failOnDeprecation="true" beStrictAboutOutputDuringTests="true">
	<testsuites>
		<testsuite name="native">
			<directory suffix="Test.php">tests/native</directory>
		</testsuite>
	</testsuites>
</phpunit>
