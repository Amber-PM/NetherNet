includes:
	- vendor/phpstan/phpstan-phpunit/extension.neon
	- vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
	level: 9
	phpVersion: 80100
	scanFiles:
		- stubs/webrtc.stub
		- stubs/rtc.stub
	tmpDir: .cache/phpstan
	paths:
		- src
		- tests/phpunit
		- tests/native
		- tests/rtc
		- scripts/reflect-webrtc.php
		- benchmarks
	reportUnmatchedIgnoredErrors: true
