namespace amber\rtc;

enum ConnectionState{
	case NEW;
	case CONNECTING;
	case CONNECTED;
	case DISCONNECTED;
	case FAILED;
	case CLOSED;
}

enum GatheringState{
	case NEW;
	case IN_PROGRESS;
	case COMPLETE;
}

final class RtcException extends \RuntimeException{
	public const INVALID_ARGUMENT = 1;
	public const CLOSED = 2;
	public const INVALID_STATE = 3;
	public const INVALID_SDP = 4;
	public const SDP_TOO_LARGE = 5;
	public const PAYLOAD_TOO_LARGE = 6;
	public const CANDIDATE_LIMIT = 7;
	public const CHANNEL_LIMIT = 8;
	public const RECEIVE_OVERFLOW = 9;
	public const BUFFER_BUDGET = 10;
	public const BACKEND_FAILURE = 11;
	public const SHUTDOWN_FAILURE = 12;
}

